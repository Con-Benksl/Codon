# Codon VPS automation config.
# Copy to ops/codon-vps.local.env and fill real values. The local file is git-ignored.

# Connection used by ops/provision-vps.sh before SSH hardening.
REMOTE_HOST=your-server-ip-or-domain
REMOTE_USER=root
BOOTSTRAP_SSH_PORT=22
SSH_IDENTITY_FILE=/absolute/path/to/private-key.pem

# Port that the server will keep after hardening. Avoid 22 for the hardened state.
SSH_PORT=22222

# Public site identity. Use a real domain for HTTPS. Use _ only for an IP-only HTTP test.
DOMAIN=_
ENABLE_HTTPS=false
LETSENCRYPT_EMAIL=

# Codon service layout on the VPS.
APP_NAME=codon
APP_USER=codon
APP_ROOT=/opt/codon
FRONTEND_ROOT=/var/www/codon
BACKEND_PORT=8000

# Bootstrap behavior.
RESET_UFW_RULES=true
COPY_ROOT_AUTHORIZED_KEYS=true
INSTALL_NODESOURCE=false
NODE_MAJOR=22

# Runtime behavior.
RUN_ALEMBIC=true
KEEP_RELEASES=5
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com

# Pull-only Git working copy on the VPS. Public HTTPS remotes need no GitHub
# credential for clone/fetch.
GIT_REMOTE_URL=https://github.com/Con-Benksl/Codon.git
GIT_BRANCH=main
SOURCE_REPO_DIR=/opt/codon/repo

# Frontend build API URL. Leave empty to derive it from DOMAIN/REMOTE_HOST.
VITE_API_URL=

# Backend environment. Leave BACKEND_SECRET_KEY empty to generate one on the VPS.
BACKEND_SECRET_KEY=
DATABASE_URL=sqlite:////opt/codon/shared/codon.db
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_PROTEIN_EXPLANATIONS_ENABLED=false

# For a real domain, use JSON, for example:
# BACKEND_CORS_ORIGINS='["https://example.com","http://example.com"]'
BACKEND_CORS_ORIGINS=
