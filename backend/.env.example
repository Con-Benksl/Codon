# ========================================
# Mars_design 后端环境变量模板
# ========================================
# 本地开发：复制为 .env 并填入本地值
# 生产部署：在部署平台环境变量面板填入生产值
# ========================================

# 数据库配置
# 本地默认 SQLite；生产建议使用 PostgreSQL
DATABASE_URL=sqlite:///./mars_design.db

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 配置
SECRET_KEY=change-me-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_MAX_AGE_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
ARTIFACT_STORAGE_DIR=uploads
MAX_UPLOAD_BYTES=10485760
VIEW_SCHEMA_VERSION=2026-03-24

# Celery 配置
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LLM 配置（中转 API，兼容 OpenAI 格式）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# CORS 配置（生产环境需修改为实际前端域名）
CORS_ORIGINS=["http://localhost:5173"]

# 服务端口
PORT=8000
