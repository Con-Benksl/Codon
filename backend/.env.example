# 数据库配置
DATABASE_URL=postgresql://postgres:password@localhost:5432/mars_design

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_MAX_AGE_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Celery 配置
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LLM 配置（中转 API，兼容 OpenAI 格式）
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://your-relay-api.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# CORS 配置（生产环境需修改为实际前端域名）
CORS_ORIGINS=["http://localhost:5173"]

# Railway 环境变量（部署时自动设置）
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
# PORT=${{PORT}}
